[0.020, "o", "\u001b[?2026h\r\u001b[10A \u001b[1C\u001b[38;2;153;153;153mCalled syntagma \u001b[1m2\u001b[22m times (ctrl+o to expand)\u001b[39m  \r\u001b[2B\u001b[38;2;255;255;255m⏺\u001b[1C\u001b[39mInteresting — they actually \u001b[3mare\u001b[23m directly\u001b[1Cconnected.\u001b[1CThe\u001b[1C\u001b[38;2;177;185;249mfind_path\u001b[1C\u001b[39mtool\u001b[1Cmay\u001b[1Chave\u001b[1Ca\u001b[1Ctraversal\u001b[1Cissue.\u001b[1CHere's\u001b[1Cthe\u001b[1Cfull\u001b[1Cpicture:\r\u001b[1B                                                                                          \r\u001b[2C\u001b[1B\u001b[1mPath: SRP → Extract Class\r\u001b[1B\u001b[22m                                                                                                                                                                                                                                             \r\u001b[1B  They\u001b[1Care\u001b[1C\u001b[1mdirectly connected\u001b[1C\u001b[22min\u001b[1Cthe\u001b[1Cknowledge\u001b[1Cgraph:\r\u001b[1B                                                                                                                                                                                                                               "]
[0.000, "o", "              \r\u001b[2C\u001b[1Bgraph LR                                                                            \r\u001b[2C\u001b[1B    SRP[\"SRP<br/>(LAW-042-S)\"] <-->|\"enforces\u001b[1C/<br/>violates\"|\u001b[1CEC[\"Extract\u001b[1CClass<br/>(RF-010)\"]\r\r\n\r\r\n\u001b[2C\u001b[1mHow\u001b[1CExtract\u001b[1CClass\u001b[1Cenforces\u001b[1CSRP\u001b[22m\r\r\n\r\r\n\u001b[38;2;136;136;136m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r"]
[0.000, "o", "\r\n\u001b[38;2;153;153;153m❯ \u001b[39m\r\r\n\u001b[38;2;136;136;136m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[2C\u001b[38;5;39mSyntagma\u001b[38;2;153;153;153m\u001b[2m \u001b[22m\u001b[38;5;76mmain\u001b[1C?1\u001b[1C!3\u001b[38;2;153;153;153m\u001b[2m \u001b[22m\u001b[38;5;76m███░░░░░░░\u001b[1C36%\u001b[38;2;153;153;153m\u001b[2m \u001b[22m\u001b[35mglm-5.1\u001b[38;2;153;153;153m\u001b[2m $0.35\u001b[1C\u001b[22m\u001b[38;5;178m4m\u001b[1C24s"]
[0.000, "o", "\u001b[38;2;153;153;153m\u001b[2m epicsagas@localhost\u001b[1C16:22:29\u001b[22m\u001b[39m\r\r\n\u001b[2C\u001b[38;2;255;107;128m⏵⏵\u001b[1Cbypass\u001b[1Cpermissions\u001b[1Con\u001b[38;2;153;153;153m (shift+tab\u001b[1Cto\u001b[1Ccycle)\u001b[39m\r\r\n\u001b[?2026l"]
[3.396, "o", "\u001b[?2026h\r\u001b[5A  Extract Class (RF-010) is a \u001b[1mmoving features\u001b[22m refactoring that splits a class with too many responsibilities into two cohesive classes. It directly enforces \u001b[1mSingle Responsibility Principle\u001b[22m (LAW-042-S) by ensuring each class has one      \r\u001b[1B  reason\u001b[1Cto\u001b[1Cchange.\r\u001b[1B                                                                                                                                                                                                                                             \r\u001b[2C\u001b[1B\u001b[1mFull neighborhood of Extract Class\u001b[22m                                                  \r\u001b[2C\u001b[1B                                             \r\r\n\u001b[2C┌───────────┬────────────────────────────┬───────┬────────────────┐\r\r\n\u001b[2C│\u001b[1CDirection\u001b[1C│\u001b[11CEntity\u001b[11C│\u001b[1CType\u001b[2C│\u001b[4CRelation\u001b[4C│\r\r\n\u001b[2C├─────────"]
[0.000, "o", "──┼────────────────────────────┼───────┼────────────────┤\r\r\n\u001b[2C│\u001b[1Csolves\u001b[4C│\u001b[1C\u001b[1mLarge\u001b[1CClass\u001b[1C\u001b[22m(SMELL-04)\u001b[5C│\u001b[1CSmell\u001b[1C│\u001b[1CPrimary\u001b[1Ctarget\u001b[1C│\r\r\n\u001b[2C├───────────┼────────────────────────────┼───────┼────────────────┤\r\r\n\u001b[2C│\u001b[1Csolves\u001b[4C│\u001b[1C\u001b[1mGod\u001b[1CObject\u001b[1C\u001b[22m(SMELL-21)\u001b[6C│\u001b[1CSmell\u001b[1C│\u001b[1CPrimary\u001b[1Ctarget\u001b[1C│\r\r\n\u001b[2C├───────────┼────────────────────────────┼───────┼────────────────┤\r\r\n\u001b[2C│\u001b[1Csolves\u001b[4C│\u001b[1C\u001b[1mTemporary\u001b[1CField\u001b[1C\u001b[22m(SMELL-08)\u001b[1C│\u001b[1CSmell\u001b[1C│\u001b[1CSecondary\u001b[6C│\r\r\n\u001b[2C└───────────┴─────────────"]
